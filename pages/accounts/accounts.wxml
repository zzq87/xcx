<!-- accounts.wxml -->
<view class="container">
  <view class="page-content">
    <view class="header">
      <text class="title">账户管理</text>
      <view class="header-actions">
        <view class="action-btn" bindtap="showAddAccountDialog">
          <text class="action-text">添加账户</text>
        </view>
        <view class="action-btn primary" bindtap="showTransferDialog">
          <text class="action-text">转账</text>
        </view>
      </view>
    </view>

    <view class="account-tabs">
      <view class="tab-item {{activeTab === 'deposit' ? 'active' : ''}}" bindtap="switchTab" data-tab="deposit">
        <text class="tab-text">存款账户</text>
      </view>
      <view class="tab-item {{activeTab === 'liability' ? 'active' : ''}}" bindtap="switchTab" data-tab="liability">
        <text class="tab-text">负债账户</text>
      </view>
    </view>

    <view class="total-balance">
      <text class="total-balance-label">总余额</text>
      <text class="total-balance-amount {{totalBalance < 0 ? 'negative' : ''}}">¥{{totalBalance}}</text>
    </view>

    <view class="account-list">
      <block wx:for="{{currentAccounts}}" wx:key="id">
        <view class="account-item">
          <view class="account-info">
            <view class="account-name-wrapper" bindtap="toggleSubaccounts" data-id="{{item.id}}">
              <text class="account-icon">{{item.icon}}</text>
              <text class="account-name">{{item.name}}</text>
              <text class="subaccount-toggle">{{item.subAccounts && item.subAccounts.length > 0 ? (item.expanded ? '▼' : '▶') : ''}}</text>
            </view>
          </view>
          <view class="account-actions">
            <view class="account-balance {{(item.subAccounts && item.subAccounts.length > 0 ? item.subAccountsTotalBalance : item.balance) < 0 ? 'negative' : ''}}">
              ¥{{item.subAccounts && item.subAccounts.length > 0 ? item.subAccountsTotalBalance : item.balance}}
            </view>
            <view class="edit-btn" bindtap="showEditAccountDialog" data-id="{{item.id}}">
              <text class="edit-btn-text">编辑</text>
            </view>
            <view class="delete-btn" bindtap="showDeleteConfirmDialog" data-id="{{item.id}}">
              <text class="delete-btn-text">删除</text>
            </view>
          </view>
        </view>
        
        <!-- 子账户列表 -->
        <view class="subaccount-list" wx:if="{{item.expanded}}">
          <!-- 显示子账户 -->
          <block wx:if="{{item.subAccounts && item.subAccounts.length > 0}}">
            <block wx:for="{{item.subAccounts}}" wx:for-item="subacc" wx:key="id">
              <view class="subaccount-item">
                <text class="subaccount-icon">{{'  ' + subacc.icon}}</text>
                <text class="subaccount-name">{{subacc.name}}</text>
                <view class="subaccount-actions">
                  <view class="subaccount-balance {{subacc.balance < 0 ? 'negative' : ''}}">
                    ¥{{subacc.balance}}
                  </view>
                  <view class="edit-btn" bindtap="showEditSubAccountDialog" data-accountid="{{subacc.parentId}}" data-subid="{{subacc.id}}" data-type="{{subacc.parentType}}">
                    <text class="edit-btn-text">编辑</text>
                  </view>
                  <view class="delete-btn" bindtap="showDeleteSubAccountConfirmDialog" data-accountid="{{subacc.parentId}}" data-subid="{{subacc.id}}" data-type="{{subacc.parentType}}">
                    <text class="delete-btn-text">删除</text>
                  </view>
                </view>
              </view>
            </block>
          </block>
          
          <!-- 显示空状态 -->
          <view wx:else class="empty-subaccounts">
            <text class="empty-text">暂无子账户</text>
          </view>
          
          <!-- 添加子账户按钮（始终显示） -->
          <view class="add-subaccount-btn" bindtap="showAddSubAccountDialog" data-id="{{item.id}}" data-type="{{activeTab}}">
            <text class="add-subaccount-btn-text">+ 添加子账户</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 转账对话框 -->
  <view class="dialog-overlay" wx:if="{{showTransferDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">转账</text>
      
      <view class="dialog-section">
        <text class="section-label">转出账户</text>
        <view class="account-select">
          <block wx:for="{{allAccounts}}" wx:key="id">
            <view class="account-option {{transferForm.fromAccountId == item.id ? 'selected' : ''}}" bindtap="selectFromAccount" data-id="{{item.id}}">
              <text class="option-icon">{{item.icon}}</text>
              <text class="option-name">{{item.name}}</text>
              <text class="option-balance">¥{{item.balance.toFixed(2)}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="dialog-section">
        <text class="section-label">转入账户</text>
        <view class="account-select">
          <block wx:for="{{allAccounts}}" wx:key="id">
            <view class="account-option {{transferForm.toAccountId == item.id ? 'selected' : ''}}" bindtap="selectToAccount" data-id="{{item.id}}">
              <text class="option-icon">{{item.icon}}</text>
              <text class="option-name">{{item.name}}</text>
              <text class="option-balance">¥{{item.balance.toFixed(2)}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="dialog-section">
        <text class="section-label">金额</text>
        <input class="dialog-input" type="digit" placeholder="请输入金额" bindinput="onTransferInput" data-field="amount" value="{{transferForm.amount}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">备注</text>
        <input class="dialog-input" placeholder="请输入备注" bindinput="onTransferInput" data-field="note" value="{{transferForm.note}}" adjust-position="true" />
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideTransferDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm" bindtap="executeTransfer">
          <text class="dialog-btn-text">确认转账</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加账户对话框 -->
  <view class="dialog-overlay" wx:if="{{showAddAccountDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">添加账户</text>
      
      <view class="dialog-section">
        <text class="section-label">账户名称</text>
        <input class="dialog-input" placeholder="请输入账户名称" bindinput="onNewAccountInput" data-field="name" value="{{newAccount.name}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">初始余额</text>
        <input class="dialog-input" type="digit" placeholder="请输入初始余额" bindinput="onNewAccountInput" data-field="balance" value="{{newAccount.balance}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">账户类型</text>
        <view class="account-type-select">
          <view class="type-option {{newAccount.type === 'deposit' ? 'selected' : ''}}" bindtap="setAccountType" data-type="deposit">
            <text class="type-text">存款账户</text>
          </view>
          <view class="type-option {{newAccount.type === 'liability' ? 'selected' : ''}}" bindtap="setAccountType" data-type="liability">
            <text class="type-text">负债账户</text>
          </view>
        </view>
      </view>
      
      <view class="dialog-section">
        <text class="section-label">账户图标</text>
        <view class="icon-selector">
          <block wx:for="{{presetIcons}}" wx:key="*this">
            <view class="icon-option {{newAccount.icon === item ? 'selected' : ''}}" bindtap="selectIcon" data-icon="{{item}}" data-for="new">
              <text class="icon-option-text">{{item}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideAddAccountDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm" bindtap="addAccount">
          <text class="dialog-btn-text">添加</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑账户对话框 -->
  <view class="dialog-overlay" wx:if="{{showEditAccountDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">编辑账户</text>
      
      <view class="dialog-section">
        <text class="section-label">账户名称</text>
        <input class="dialog-input" placeholder="请输入账户名称" bindinput="onEditAccountInput" data-field="name" value="{{editAccount.name}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">当前余额</text>
        <input class="dialog-input" type="digit" placeholder="请输入当前余额" bindinput="onEditAccountInput" data-field="balance" value="{{editAccount.balance}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">账户图标</text>
        <view class="icon-selector">
          <block wx:for="{{presetIcons}}" wx:key="*this">
            <view class="icon-option {{editAccount.icon === item ? 'selected' : ''}}" bindtap="selectIcon" data-icon="{{item}}" data-for="edit">
              <text class="icon-option-text">{{item}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideEditAccountDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm" bindtap="saveEditAccount">
          <text class="dialog-btn-text">保存</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 删除确认对话框 -->
  <view class="dialog-overlay" wx:if="{{showDeleteConfirmDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">确认删除</text>
      
      <view class="dialog-section">
        <text class="section-label">确定要删除该账户吗？此操作不可恢复。</text>
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideDeleteConfirmDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm danger" bindtap="deleteAccount">
          <text class="dialog-btn-text">删除</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 添加子账户对话框 -->
  <view class="dialog-overlay" wx:if="{{showAddSubAccountDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">添加子账户</text>
      
      <view class="dialog-section">
        <text class="section-label">子账户名称</text>
        <input class="dialog-input" placeholder="请输入子账户名称" bindinput="onNewSubAccountInput" data-field="name" value="{{newSubAccount.name}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">初始余额</text>
        <input class="dialog-input" type="digit" placeholder="请输入初始余额" bindinput="onNewSubAccountInput" data-field="balance" value="{{newSubAccount.balance}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">账户图标</text>
        <view class="icon-selector">
          <block wx:for="{{presetIcons}}" wx:key="*this">
            <view class="icon-option {{newSubAccount.icon === item ? 'selected' : ''}}" bindtap="selectIcon" data-icon="{{item}}" data-for="newSub">
              <text class="icon-option-text">{{item}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideAddSubAccountDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm" bindtap="addSubAccount">
          <text class="dialog-btn-text">添加</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 编辑子账户对话框 -->
  <view class="dialog-overlay" wx:if="{{showEditSubAccountDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">编辑子账户</text>
      
      <view class="dialog-section">
        <text class="section-label">子账户名称</text>
        <input class="dialog-input" placeholder="请输入子账户名称" bindinput="onEditSubAccountInput" data-field="name" value="{{editSubAccount.name}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">当前余额</text>
        <input class="dialog-input" type="digit" placeholder="请输入当前余额" bindinput="onEditSubAccountInput" data-field="balance" value="{{editSubAccount.balance}}" adjust-position="true" />
      </view>
      
      <view class="dialog-section">
        <text class="section-label">账户图标</text>
        <view class="icon-selector">
          <block wx:for="{{presetIcons}}" wx:key="*this">
            <view class="icon-option {{editSubAccount.icon === item ? 'selected' : ''}}" bindtap="selectIcon" data-icon="{{item}}" data-for="editSub">
              <text class="icon-option-text">{{item}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideEditSubAccountDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm" bindtap="saveEditSubAccount">
          <text class="dialog-btn-text">保存</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 删除子账户确认对话框 -->
  <view class="dialog-overlay" wx:if="{{showDeleteSubAccountConfirmDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">确认删除</text>
      
      <view class="dialog-section">
        <text class="section-label">确定要删除该子账户吗？此操作不可恢复。</text>
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideDeleteSubAccountConfirmDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm danger" bindtap="deleteSubAccount">
          <text class="dialog-btn-text">删除</text>
        </view>
      </view>
    </view>
  </view>
</view>