/* categories.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.category-tabs {
  display: flex;
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #07c160;
}

.tab-item.active .tab-text {
  color: white;
  font-weight: bold;
}

.tab-text {
  font-size: 32rpx;
  color: #666;
  transition: all 0.3s;
}

.category-list {
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
  overflow: hidden;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.category-item:last-child {
  border-bottom: none;
}

.category-item:hover {
  background-color: #fafafa;
}

.category-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.category-name-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  cursor: pointer;
  padding: 8rpx 0;
  transition: all 0.2s;
}

.category-name-wrapper:active {
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
}

.category-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.category-name {
  font-size: 32rpx;
  color: #333;
  flex: 1;
}

.subcategory-toggle {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
  transition: transform 0.2s;
}

.subcategory-list {
  background-color: #fafafa;
  padding-left: 20rpx;
  border-left: 2rpx solid #eee;
}

.subcategory-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.subcategory-name {
  font-size: 28rpx;
  color: #666;
}

.subcategory-item .category-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  width: 36rpx;
}

.add-subcategory {
  padding: 16rpx 24rpx;
  text-align: center;
  cursor: pointer;
}

.add-subcategory-text {
  font-size: 28rpx;
  color: #07c160;
}

.empty-subcategories {
  padding: 24rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  color: #999;
}

.dialog-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.dialog-content {
  background-color: white;
  border-radius: 12rpx;
  padding: 32rpx;
  width: 90%;
  max-width: 90%; /* 放宽宽度限制以显示更多图标 */
}

.edit-dialog {
  width: 90%;
  max-width: 90%;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.dialog-input {
  width: 100%;
  padding: 24rpx 20rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
}

.dialog-buttons {
  display: flex;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
}

.dialog-btn.cancel {
  background-color: #f5f5f5;
}

.dialog-btn.cancel .dialog-btn-text {
  color: #666;
}

.dialog-btn.confirm {
  background-color: #07c160;
}

.dialog-btn.confirm .dialog-btn-text {
  color: white;
}

.dialog-btn-text {
  font-size: 32rpx;
  font-weight: bold;
}

/* 编辑弹窗样式 */
.edit-dialog {
  width: 90%;
  max-width: 600rpx;
  max-height: 85vh; /* 限制最大高度，防止超出屏幕 */
  display: flex;
  flex-direction: column;
  overflow-y: auto; /* 允许弹窗内容滚动 */
  padding-bottom: 20rpx;
}

.dialog-section {
  margin-top: 24rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  text-align: left;
}

/* 图标选择器样式 (完全复用账户管理) */
.icon-selector {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx;
  max-height: 300rpx;
  overflow-y: auto;
}

.icon-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background-color: white;
  border-radius: 8rpx;
  cursor: pointer;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.icon-option:active {
  transform: scale(0.95);
}

.icon-option.selected {
  border-color: #1890ff;
  background-color: #e6f7ff;
}

.icon-option-text {
  font-size: 40rpx;
}

.category-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  cursor: pointer;
  transition: all 0.2s;
}

.action-btn.edit {
  background-color: #e6f7ff;
}

.action-btn.edit .action-text {
  color: #1890ff;
}

.action-btn.delete {
  background-color: #fff2f0;
}

.action-btn.delete .action-text {
  color: #ff4d4f;
}

.action-text {
  font-size: 24rpx;
  font-weight: 500;
}

.add-section {
  background-color: white;
  padding: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.input-item {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background-color: white;
  text-align: left;
}

.btn {
  padding: 24rpx;
  background-color: #07c160;
  color: white;
  border-radius: 12rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btn:hover {
  background-color: #06b356;
}