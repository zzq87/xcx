<!--index.wxml-->
<view class="container">
  <scroll-view class="page-content" scroll-y="true" bindfocus="onInputFocus">
    <view class="header">
      <text class="title">今日记账</text>
      <text class="date">{{currentDate}}</text>
    </view>

    <view class="input-section" id="inputSection">
      <view class="input-item">
        <text class="label">类型</text>
        <view class="type-buttons">
          <view class="type-btn {{typeIndex === 0 ? 'selected' : ''}}" bindtap="onTypeChange" data-index="0">
            <text class="type-btn-text">{{types[0]}}</text>
          </view>
          <view class="type-btn {{typeIndex === 1 ? 'selected' : ''}}" bindtap="onTypeChange" data-index="1">
            <text class="type-btn-text">{{types[1]}}</text>
          </view>
        </view>
      </view>

      <view class="input-item">
        <text class="label">金额</text>
        <input class="input" type="digit" placeholder="请输入金额" bindinput="onAmountInput" value="{{amount}}" focus="{{focusAmount}}" adjust-position="true" />
      </view>

      <view class="input-item">
        <text class="label">备注</text>
        <input class="input" placeholder="请输入备注" bindinput="onNoteInput" value="{{note}}" adjust-position="true" />
      </view>

      <view class="input-row">
        <view class="input-item-half">
          <text class="label">日期</text>
          <picker class="select" mode="date" start="2020-01-01" end="2100-12-31" bindchange="onDateChange" value="{{currentDate}}">
            <view class="picker-text">{{currentDate}}</view>
          </picker>
        </view>
        <view class="input-item-half">
          <text class="label">时间</text>
          <picker class="select" mode="time" bindchange="onTimeChange" value="{{currentTime}}">
            <view class="picker-text">{{currentTime}}</view>
          </picker>
        </view>
      </view>

      <view class="input-item">
        <text class="label">账户</text>
        <view class="category-grid">
          <!-- 所有账户放在一起显示 -->
          <block wx:for="{{allAccounts}}" wx:key="id">
            <view class="category-item {{selectedAccountId == item.id ? 'selected' : ''}}" bindtap="selectAccount" data-id="{{item.id}}">
              <text class="category-icon">{{item.icon}}</text>
              <text class="category-name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="input-item">
        <text class="label">分类</text>
        <view class="category-grid">
          <block wx:for="{{categoryData}}" wx:key="id">
            <view class="category-item {{selectedCategoryId === item.id ? 'selected' : ''}}" bindtap="selectCategory" data-index="{{index}}" data-id="{{item.id}}">
              <text class="category-icon">{{item.icon}}</text>
              <text class="category-name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="input-item" wx:if="{{subcategories.length > 0}}">
        <text class="label">子分类</text>
        <view class="category-grid subcategory-grid">
          <block wx:for="{{categoryData[categoryIndex].subcategories}}" wx:key="id">
            <view class="category-item {{selectedSubcategoryId === item.id ? 'selected' : ''}}" bindtap="selectSubcategory" data-index="{{index}}" data-id="{{item.id}}">
              <text class="category-icon">{{item.icon}}</text>
              <text class="category-name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="btn" bindtap="addRecord">添加记录</view>
    </view>

    <view class="records-section">
      <text class="section-title">今日记录</text>
      <view class="records-list">
        <block wx:for="{{todayRecords}}" wx:key="index">
          <view class="record-item" bindtap="showEditRecordDialog" data-record="{{item}}">
            <view class="record-info">
              <text class="record-category">{{item.category}}</text>
              <text class="record-note">{{item.note}}</text>
              <text class="record-meta">
                <text class="record-time">{{item.time}}</text>
                <text class="record-account">{{item.accountIcon}} {{item.accountName}}</text>
              </text>
            </view>
            <text class="record-amount {{item.type === '支出' ? 'expense' : 'income'}}">
              {{item.type === '支出' ? '-' : '+'}}{{item.amount}}
            </text>
          </view>
        </block>
        <view wx:if="{{todayRecords.length === 0}}" class="no-records">
          <text>今日暂无记录</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 编辑记录对话框 -->
  <view class="dialog-overlay" wx:if="{{showEditRecordDialog}}">
    <view class="dialog-content">
      <text class="dialog-title">编辑记录</text>
      
      <view class="input-item">
        <text class="label">类型</text>
        <view class="type-buttons">
          <view class="type-btn {{editRecord.type === types[0] ? 'selected' : ''}}" bindtap="onEditTypeChange" data-type="{{types[0]}}">
            <text class="type-btn-text">{{types[0]}}</text>
          </view>
          <view class="type-btn {{editRecord.type === types[1] ? 'selected' : ''}}" bindtap="onEditTypeChange" data-type="{{types[1]}}">
            <text class="type-btn-text">{{types[1]}}</text>
          </view>
        </view>
      </view>
      
      <view class="input-item">
        <text class="label">金额</text>
        <input class="input" type="digit" placeholder="请输入金额" bindinput="onEditAmountInput" value="{{editRecord.amount}}" adjust-position="true" />
      </view>
      
      <view class="input-item">
        <text class="label">备注</text>
        <input class="input" placeholder="请输入备注" bindinput="onEditNoteInput" value="{{editRecord.note}}" adjust-position="true" />
      </view>
      
      <view class="input-row">
        <view class="input-item-half">
          <text class="label">日期</text>
          <picker class="select" mode="date" start="2020-01-01" end="2100-12-31" bindchange="onDateChange" value="{{editRecord.date}}">
            <view class="picker-text">{{editRecord.date}}</view>
          </picker>
        </view>
        <view class="input-item-half">
          <text class="label">时间</text>
          <picker class="select" mode="time" bindchange="onTimeChange" value="{{editRecord.time}}">
            <view class="picker-text">{{editRecord.time}}</view>
          </picker>
        </view>
      </view>
      
      <view class="input-item">
        <text class="label">账户</text>
        <view class="category-grid">
          <block wx:for="{{allAccounts}}" wx:key="id">
            <view class="category-item {{editRecord.accountId == item.id ? 'selected' : ''}}" bindtap="onEditAccountChange" data-id="{{item.id}}">
              <text class="category-icon">{{item.icon}}</text>
              <text class="category-name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="input-item">
        <text class="label">分类</text>
        <view class="category-grid">
          <block wx:for="{{categoryData}}" wx:key="id">
            <view class="category-item {{editRecord.selectedCategoryId === item.id ? 'selected' : ''}}" bindtap="onEditCategoryChange" data-index="{{index}}">
              <text class="category-icon">{{item.icon}}</text>
              <text class="category-name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="input-item" wx:if="{{subcategories.length > 0}}">
        <text class="label">子分类</text>
        <view class="category-grid subcategory-grid">
          <block wx:for="{{categoryData[0].subcategories}}" wx:key="id">
            <view class="category-item {{editRecord.selectedSubcategoryId === item.id ? 'selected' : ''}}" bindtap="onEditSubcategoryChange" data-index="{{index}}">
              <text class="category-icon">{{item.icon}}</text>
              <text class="category-name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="dialog-buttons">
        <view class="dialog-btn cancel" bindtap="hideEditRecordDialog">
          <text class="dialog-btn-text">取消</text>
        </view>
        <view class="dialog-btn confirm" bindtap="saveEditRecord">
          <text class="dialog-btn-text">保存</text>
        </view>
      </view>
    </view>
  </view>
</view>