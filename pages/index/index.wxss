/* index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.date {
  font-size: 28rpx;
  color: #666;
}

.input-section {
  background-color: white;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.input-item {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input, .select {
  width: 100%;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background-color: white;
}

.picker-text {
  font-size: 32rpx;
  color: #333;
  flex: 1;
}

.btn {
  padding: 20rpx;
  background-color: #07c160;
  color: white;
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 20rpx;
  cursor: pointer;
}

.records-section {
  background-color: white;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.records-list {
  flex: 1;
  overflow-y: auto;
  min-height: 0;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
}

.record-category {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 5rpx;
}

.record-note {
  font-size: 24rpx;
  color: #999;
}

.record-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  width: 100%;
}

.record-time {
  margin-right: 20rpx;
}

.record-account {
  display: flex;
  align-items: center;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.expense {
  color: #ff4d4f;
}

.income {
  color: #07c160;
}

.no-records {
  text-align: center;
  padding: 50rpx 0;
  color: #999;
}

/* 对话框样式 */
.dialog-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 40rpx 0;
  z-index: 1000;
}

.dialog-content {
  background-color: white;
  border-radius: 8rpx;
  padding: 30rpx;
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  cursor: pointer;
}

.dialog-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.dialog-btn.confirm {
  background-color: #07c160;
  color: white;
}

/* 分类网格样式 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 10rpx;
}

/* 账户列表样式 */
.account-list {
  margin-top: 10rpx;
  background-color: white;
  border-radius: 12rpx;
  padding: 16rpx;
}

/* 账户分类样式 */
.account-category {
  margin-bottom: 20rpx;
}

.account-category:last-child {
  margin-bottom: 0;
}

.account-category-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.account-category-items {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 账户列表的分类项样式 */
.account-list .category-item {
  width: 100%;
  min-height: auto;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  text-align: left;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  overflow: hidden;
  margin-bottom: 8rpx;
}

/* 分类网格的分类项样式 */
.category-grid .category-item {
  width: calc(20% - 16rpx);
  min-height: 100rpx;
  padding: 16rpx 0;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  margin-bottom: 0;
}

.category-item:active {
  transform: scale(0.95);
}

.category-item.selected {
  background-color: #e6f7ff;
  border: 2rpx solid #1890ff;
}

.category-item .category-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.category-item .category-name {
  font-size: 22rpx;
  color: #333;
  line-height: 1.2;
  word-break: break-all;
  padding: 0 4rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 子分类网格样式 */
.subcategory-grid .category-item {
  width: calc(20% - 16rpx);
  min-height: 100rpx;
}

.subcategory-grid .category-item .category-icon {
  font-size: 36rpx;
}

.subcategory-grid .category-item .category-name {
  font-size: 22rpx;
}

/* 类型按钮组样式 */
.type-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

/* 日期时间同行显示样式 */
.input-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.input-item-half {
  flex: 1;
  margin-bottom: 0;
}

.input-item-half .label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input-item-half .select {
  width: 100%;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background-color: white;
}

.type-btn {
  flex: 1;
  padding: 20rpx 0;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
}

.type-btn.selected {
  background-color: #e6f7ff;
  border: 2rpx solid #1890ff;
}

.type-btn .type-btn-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.type-btn.selected .type-btn-text {
  color: #1890ff;
  font-weight: bold;
}