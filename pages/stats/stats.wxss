/* stats.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.date {
  font-size: 28rpx;
  color: #666;
}

.stats-summary {
  display: flex;
  justify-content: space-around;
  background-color: white;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
}

.summary-item.income .summary-amount {
  color: #07c160;
}

.summary-item.expense .summary-amount {
  color: #ff4d4f;
}

.summary-item.balance .summary-amount {
  color: #1890ff;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.summary-amount {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

.chart-section {
  background-color: white;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.chart {
  width: 100%;
  height: 300rpx;
  flex: 1;
  min-height: 300rpx;
}

/* 图表切换选项样式 */
.chart-tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #07c160;
}

.tab-item.active .tab-text {
  color: white;
  font-weight: bold;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}