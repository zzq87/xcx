<!--stats.wxml-->
<view class="container">
  <view class="page-content">
<view class="header">
      <text class="title">收支统计</text>
    </view>

    <view class="stats-summary">
      <view class="summary-item income">
        <text class="summary-label">本月收入</text>
        <text class="summary-amount">¥{{totalIncome || 0}}</text>
      </view>
      <view class="summary-item expense">
        <text class="summary-label">本月支出</text>
        <text class="summary-amount">¥{{totalExpense || 0}}</text>
      </view>
      <view class="summary-item balance">
        <text class="summary-label">本月结余</text>
        <text class="summary-amount">¥{{balance || 0}}</text>
      </view>
    </view>

    <!-- 日期选择器 -->
<view class="date-range-picker">
       <view class="date-picker-item">
         <text class="date-picker-label">开始日期</text>
         <picker mode="date" value="{{startDate}}" fields="day" end="{{endDate}}" bindchange="onStartDateChange">
           <view class="date-picker-input">
             <text>{{startDate}}</text>
           </view>
         </picker>
       </view>
       <view class="date-separator">至</view>
       <view class="date-picker-item">
         <text class="date-picker-label">结束日期</text>
         <picker mode="date" value="{{endDate}}" fields="day" start="{{startDate}}" bindchange="onEndDateChange">
           <view class="date-picker-input">
             <text>{{endDate}}</text>
           </view>
         </picker>
       </view>
     </view>
    
    <!-- 快捷日期选择 -->
    <view class="quick-date-selector">
      <view class="quick-date-btn {{activeQuickDate === 'week' ? 'active' : ''}}" bindtap="onQuickDateSelect" data-type="week">本周</view>
      <view class="quick-date-btn {{activeQuickDate === 'month' ? 'active' : ''}}" bindtap="onQuickDateSelect" data-type="month">本月</view>
      <view class="quick-date-btn {{activeQuickDate === 'threeMonth' ? 'active' : ''}}" bindtap="onQuickDateSelect" data-type="threeMonth">三个月</view>
    </view>

    <view class="chart-section">
      <text class="section-title">分类统计</text>
      <view class="chart-tabs">
        <view class="tab-item {{chartType === 'category' ? 'active' : ''}}" bindtap="switchChartType" data-type="category">
          <text class="tab-text">大类</text>
        </view>
        <view class="tab-item {{chartType === 'subcategory' ? 'active' : ''}}" bindtap="switchChartType" data-type="subcategory">
          <text class="tab-text">小类</text>
        </view>
      </view>
      <canvas id="categoryChart" type="2d" class="chart"></canvas>
    </view>

    <view class="chart-section">
      <text class="section-title">日统计</text>
      <canvas id="dailyChart" type="2d" class="chart"></canvas>
    </view>
    
    <view class="export-section">
      <view class="export-btn" bindtap="exportData">
        <text class="export-btn-text">导出数据到表格</text>
      </view>
    </view>
    

  </view>
</view>